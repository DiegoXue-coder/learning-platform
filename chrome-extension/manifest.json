{
  "manifest_version": 3,
  "name": "Moodle 内容提取助手",
  "version": "3.0",
  "description": "一键提取 Moodle 课程内容（公告、作业、PDF、论坛），同步到学习平台",
  "permissions": ["cookies", "tabs", "scripting", "storage", "clipboardWrite"],
  "host_permissions": ["https://moodle.telt.unsw.edu.au/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Moodle 内容提取助手"
  }
}